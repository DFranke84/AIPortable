# Dependencies (restore with npm install)
node_modules/

# User data: chats, library, models, maps, Wikipedia (~119 GB) - but keep the
# hand-edited catalogs that setup and the app read
data/*
!data/*-models-catalog.json
!data/wikipedia-catalog.json
!data/maps-catalog.json

# Bundled third-party binaries (see SETUP.md for how to obtain)
resources/ollama/
resources/kiwix/
resources/maps/tools/*.exe
resources/maps/tools/*.zip
resources/whisper/**/*.exe
resources/whisper/**/*.bin

# Build output
dist/
out/

# Scratch / misc
t.html
*.log
Thumbs.db
desktop.ini

# Written by the suite updater (what version is installed)
release-manifest.json
